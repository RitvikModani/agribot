# Copy to .env.local for local dev against the real backend. Leave unset to run in REPLAY mode.
# The anon key is public by design: row-level security decides what it can read.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Used by the "Wake API" button.
VITE_API_URL=https://YOUR-HF-USERNAME-agribot-api.hf.space
